#include <bits/stdc++.h>
using namespace std;
const int nm = 1e6 + 9;
const int N = 1e3 + 9;
#define el '\n'
int n,a[nm],f[nm],q; 

signed main (){
	ios_base::sync_with_stdio(false);
	cin.tie(NULL); cout.tie(NULL);
	cin >> n >> q; 
	for (int i = 1; i <= n; i++){
		cin >> a[i];
		f[i] = f[i - 1] + a[i];
	}
	while (q--){
		int l,r; cin >> l >> r; 
		cout << f[r + 1] - f[l] << el; 
	}
	return 0;
}
