#include <bits/stdc++.h>
using namespace std;
const int nm = 1e6 + 9;
const int N = 1e3 + 9;
#define el '\n'
#define int long long
int a[nm],f[nm];
void solve(){
    int n; cin >> n;
    f[0] = 0; 
    for (int i = 1; i <= n; i++){
    	cin >> a[i]; 
    	f[i] = f[i - 1] + a[i];
	}
	for (int i = 1; i <= n; i++) cout << f[i] << " ";
}

signed main (){
	ios_base::sync_with_stdio(false);
	cin.tie(NULL); cout.tie(NULL);
	int t = 1; 
	while (t--){
	    solve();
	}
	return 0;
}
