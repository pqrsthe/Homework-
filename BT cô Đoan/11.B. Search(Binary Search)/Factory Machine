#include <bits/stdc++.h>
using namespace std;
#define int long long
const int nm = 1e6 + 9;
const int N = 1e3 + 9;
const int INF = 2e16; 
#define el '\n'
int ans = 0; 
int n,t,a[nm]; 

int check(int val, int t){
	int tong = 0; 
	for (int i = 1; i <= n; i++){
		tong += val / a[i]; 
		if (tong >= t) return true; 
	}
	return false; 
}

signed main (){
	ios_base::sync_with_stdio(false);
	cin.tie(NULL); cout.tie(NULL);
	cin >> n >> t; 
	for (int i = 1; i <= n; i++){
		cin >> a[i]; 
	}
	int l = 1, r = INF;
	a[n+1] = 1e18; 
	while (l <= r){
		int mid = (l + r) / 2; 
		int sta = check(mid,t); 
		if (sta){
			ans = mid; 
			r = mid - 1; 
		}
		else l = mid + 1; 
	}
	cout << ans; 
	return 0;
}
