#include <bits/stdc++.h>
using namespace std;
const int nm = 1e6 + 9;
const int N = 1e3 + 9;
#define el '\n'
vector <int> a,b; 

int main (){
	ios_base::sync_with_stdio(false);
	cin.tie(NULL); cout.tie(NULL);
	int n,m; cin >> n >> m; 
	for (int i = 0; i < n; i++){
		int x; cin >> x; a.push_back(x);
	}
	for (int i = 0; i < m; i++){
		int x; cin >> x; b.push_back(x); 
	}
	sort(b.begin(), b.end()); 
	for (int i = 0; i < a.size(); i++){
		int val = a[i]; 
		auto pos = lower_bound(b.begin(), b.end(), val); 
		if (pos != b.end()){
			pos--; 
			int vt = distance(b.begin(), pos);
			cout << m - vt - 1 << " "; 
		}
		else cout << "0" << " "; 
	}
	return 0;
}
