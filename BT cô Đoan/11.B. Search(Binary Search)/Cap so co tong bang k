#include <bits/stdc++.h>
using namespace std;
#define int long long
const int nm = 1e6+9;
int a[nm],ans,n,k;
int left(int l, int r, int x){
	int ans = -1;
	while (l <= r){
		int mid = (l + r) / 2;
        if (a[mid] == x) return mid;
		if (a[mid] > x){
			r = mid - 1;	
		} 
		else l = mid + 1;
	}
	return ans;
}

int right(int l, int r, int x){
	int ans = -1;
	while (l <= r){
		int mid = (l + r) / 2;
		if (a[mid] <= x){
			ans = mid;
			l = mid + 1;
		}
		else r = mid - 1;
	}
	return ans;
}

signed main(){
    cin >> n >> k;
    for (int I = 1; I <= n; I++){
        cin >> a[I];
    }
    sort(a+1,a+1+n);
    int dem = 0;
    for (int i = 1; i <= n; i++){
        int l = left(1,n,k-a[i]);
        int vt1 = l, vt2 = l;
        while (a[vt1] == a[l]) vt1--;
        while (a[vt2] == a[l]) vt2++;
        //cout << vt1 << " " << vt2 << endl;
        if (l !=-1){
             dem += ((vt2-1) - (vt1+1)+1);
             if (k == 2*a[i]) dem--;
        }
    }
    cout << dem/2;
}
