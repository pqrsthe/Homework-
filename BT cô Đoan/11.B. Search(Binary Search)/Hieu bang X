#include <bits/stdc++.h>
using namespace std;
const int nm = 1e6 + 9;
const int N = 1e3 + 9;
#define el '\n'
#define int long long
map <int,int> mp;
int ans; 
int a[nm];
int find(int l, int r, int cur){
	while (l <= r){
		int mid = (l + r) / 2; 
		if (a[mid] == cur) return 1; 
		else if (a[mid] > cur) r = mid -1; 
		else l = mid + 1; 
	}
	return -1; 
}

signed main (){
	ios_base::sync_with_stdio(false);
	cin.tie(NULL); cout.tie(NULL);
	int n,x; cin >> n >> x; 
	for (int i = 1; i <= n; i++){
		cin >> a[i]; 	
	}
	sort (a + 1, a + 1 + n); 
	for (int i = 1; i <= n; i++){
		int cur = x + a[i]; 
		int pos = find(1,n,cur); 
		if (pos != -1){
			cout << 1; return 0;
		}
	}
	cout << -1; 
	return 0;
}
