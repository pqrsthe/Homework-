#include <bits/stdc++.h>
using namespace std;
#define int long long
const int nm = 1e6+9;
int a[nm],n,k;
int left(int l, int r, int x){
	int ans = -1;
	while (l <= r){
		int mid = (l + r) / 2;
        if (a[mid] == x) return mid;
		if (a[mid] > x){
			r = mid - 1;	
		} 
		else l = mid + 1;
	}
	return ans;
}

int right(int l, int r, int x){
	int ans = -1;
	while (l <= r){
		int mid = (l + r) / 2;
		if (a[mid] <= x){
			ans = mid;
			l = mid + 1;
		}
		else r = mid - 1;
	}
	return ans;
}

signed main(){
    cin >> n >> k;
    for (int I = 1; I <= n; I++){
        cin >> a[I];
    }
    sort(a+1,a+1+n);
    int dem = 0;
    for (int i = 1; i <= n; i++){
        int l = right(1,n,k-a[i]);
        //cout << vt1 << " " << vt2 << endl;
        if (l !=-1){
            if (l < i) dem += l;
            else dem += l -1;
        }
    }
    int ans = n * (n-1)/2; ans -= dem/2;  
    cout << ans; 
}
