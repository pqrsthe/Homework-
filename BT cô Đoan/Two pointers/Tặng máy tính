#include <bits/stdc++.h>
using namespace std;
const int nm = 1e6 + 9;
const int N = 1e3 + 9;
#define el '\n'
int b[nm],a[nm];
int n,m,k; 

int main (){
	ios_base::sync_with_stdio(false);
	cin.tie(NULL); cout.tie(NULL);
	cin >> n >> m >> k; 
	for (int i = 1; i <= n; i++) cin >> a[i]; 
	for (int i = 1; i <= m; i++) cin >> b[i];
	sort (a + 1, a + 1 + n); sort(b + 1, b + 1 + m); 
	int i = 1,dem=0, j = 1; 
	while (j <= m  && i <= n){
		if (a[i] >= (b[j] - k) && a[i] <= (b[j] + k)){
			dem++; i++; j++; 
		}
		else if (a[i] < (b[j]-k)) i++; 
		else if (a[i] > (b[j] + k)) j++;
	}
	cout << dem; 
	return 0;
}
