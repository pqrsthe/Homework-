#include <bits/stdc++.h>
using namespace std;
const int nm = 1e6 + 9;
const int N = 1e3 + 9;
const int MOD = 1e9 + 7;
#define el '\n'
int n,a[nm],s,ans,sum;
signed main(){
	ios_base::sync_with_stdio(false);
	cin.tie(NULL); cout.tie(NULL);
	cin >> n >> s; 
	for (int i = 1; i <= n; i++) cin >> a[i]; 
	int i = 1; 
	for (int j = 1; j <= n; j++){
		sum += a[j];
		while (sum > s){
			sum -= a[i];
			i++; 
		}
		ans += j - i + 1; 
	}
	cout << ans; 
	return 0;
}
