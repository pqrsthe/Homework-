#include <bits/stdc++.h>
using namespace std;
const int nm = 1e6 + 9;
const int N = 1e3 + 9;
#define el '\n'
int n,s,a[nm];
signed main (){
	ios_base::sync_with_stdio(false);
	cin.tie(NULL); cout.tie(NULL);
	cin >> n >> s; 
	for (int i = 1; i<= n; i++) cin >> a[i]; 
	sort (a + 1, a + 1 + n); 
	for (int i = 1; i <= n - 2; i++){
		int j = i + 1, k = n, cur = s - a[i]; 
		while (j <= n && k >=1 && j != k){
			if (a[j] + a[k] == cur){
				cout << "YES"; return 0;
			}
			else if (a[j] + a[k] < cur) j++; 
			else k--;
		}
	}
	cout << "NO";
	return 0;
}
