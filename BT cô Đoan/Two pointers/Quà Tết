#include <bits/stdc++.h>
using namespace std;
const int nm = 1e6 + 9;
const int N = 1e3 + 9;
#define el '\n'
#define int long long
int a[nm],ans;
void solve(){
	long long res = 0; 
    int n,s; cin >> n >> s; 
    for (int i = 1; i <= n; i++) cin >> a[i]; 
	int i = 1, j = 1; a[n + 1] = 1e17;
	while (i <= n+1&& j <= n+1){
		res += a[j]; 
		while (res > s){
			ans = max(ans , j - i);
			res -= a[i];
			i++;
		}
		j++; 
	}
	cout << ans;
}

signed main (){
	ios_base::sync_with_stdio(false);
	cin.tie(NULL); cout.tie(NULL);
	int t = 1; 
	while (t--){
	    solve();
	}
	return 0;
}
