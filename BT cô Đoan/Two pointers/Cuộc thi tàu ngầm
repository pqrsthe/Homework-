#include <bits/stdc++.h>
using namespace std;
const int nm = 1e6 + 9;
const int N = 1e3 + 9;
#define el '\n'
int b[nm],a[nm];
int n,m;

int main (){
	ios_base::sync_with_stdio(false);
	cin.tie(NULL); cout.tie(NULL);
	cin >> n >> m; 
	for (int i = 1; i <= n; i++) cin >> a[i]; 
	for (int i = 1; i <= m; i++) cin >> b[i];
	sort (a + 1, a + 1 + n); sort(b + 1, b + 1 + m); 
	int j = 1, i = 1, dem = 0,ans = 0;
	while (i <= n && j <= m){
		if (abs(a[i] - b[j]) <= 1){
			dem++; 
			i++; j++;
		}
		else if (abs(a[i] - b[j]) > 1 && a[i] > b[j]){
			j++;
		}
		else if (abs(a[i] - b[j]) > 1 && a[i] < b[j]){
			i++;
		}
	} 	
	cout << dem;
	return 0;
}
