#include <bits/stdc++.h>
using namespace std;
const int nm = 1e6 + 9;
const int N = 1e3 + 9;
#define el '\n'
int a[nm],b[nm]; 

int main (){
	ios_base::sync_with_stdio(false);
	cin.tie(NULL); cout.tie(NULL);
	int n,m; cin >> n >> m; 
	for (int i = 1; i <= n; i++) cin >> a[i]; 
	for (int j = 1; j <= m; j++) cin >> b[j]; 
	int i = 1, j = 1, dem = 0;
	sort (a + 1, a + 1 + n); sort(b+1, b+1+m);  
	while (i <= n && j <= m){
		if (a[i] > b[j]){
			dem++; 
			i++; j++; 
		}
		else{
			i++; 
		}
	}
	cout << dem; 
	return 0;
}
