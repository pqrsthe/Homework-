#include <bits/stdc++.h>
using namespace std;
const int nm = 1e6 + 9;
const int N = 1e3 + 9;
#define el '\n'
#define int long long
int a[nm],ans=1e9;
void solve(){
	long long res = 0; 
    int n,s; cin >> n >> s; 
    for (int i = 1; i <= n; i++) cin >> a[i]; 
	int i = 1, j = 1; 
	while (i <= n&& j <= n){
		res += a[j]; 
		while (res >= s){
			if (res < s) break; 
			ans = min(ans , j - i + 1);
			res -= a[i];
			i++;
		}
		j++; 
	}
	if (ans != 1e9) cout << ans;
	else cout << -1; 
}

signed main (){
	ios_base::sync_with_stdio(false);
	cin.tie(NULL); cout.tie(NULL);
	int t = 1; 
	while (t--){
	    solve();
	}
	return 0;
}
