#include <bits/stdc++.h>
using namespace std;
const int nm = 1e6 + 9;
const int N = 1e3 + 9;
#define el '\n'
int n,m,a[nm];
map<int,int> mp; 
signed main (){
	ios_base::sync_with_stdio(false);
	cin.tie(NULL); cout.tie(NULL);
	cin >> n >> m; 
	for (int i = 1; i <= n; i++) cin >> a[i]; 
	int i = 1, j = 1; int ans = 1e9; 
	while (i <= n && j <= n){
		mp[a[j]]++; 
		while (mp.size() == m){
			ans = min(ans, j - i + 1); 
			mp[a[i]]--; 
			if (mp[a[i]] == 0) mp.erase(a[i]); 
			i++; 
		}
		j++; 
	}
	cout << ans; 
	return 0;
}
