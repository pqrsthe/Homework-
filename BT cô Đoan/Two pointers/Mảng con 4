int a[nm]; 
void solve(){
	int n,l,d; cin >> n >> d;  
	for (int i = 1; i <= n; i++){
		cin >> a[i]; 
	}
	int ans = 0, j = 1;
	deque <int> mx,mn; 
	for (int i = 1; i <= n; i++){
		while (!mx.empty() && a[i] > a[mx.back()]) mx.pop_back(); 
		while (!mn.empty() && a[i] < a[mn.back()]) mn.pop_back(); 
		mx.push_back(i); mn.push_back(i); 
		while (a[mx.front()] - a[mn.front()] > d){
			j++;
			if (mx.front() < j) mx.pop_front();
			if (mn.front() < j) mn.pop_front();
		}
		if (j <= (i)){
			ans += i - j + 1; 
		}
	}
	cout << ans;
}

signed main (){
	int t; t = 1;
	while (t--){
		solve();
	}
	return 0;
}
