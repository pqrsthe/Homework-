#include <bits/stdc++.h>
using namespace std;
const int nm = 1e6 + 9;
const int N = 1e3 + 9;
const int MOD = 1e9 + 7;
#define el '\n'
int n,k,a[nm],ans; 

signed main (){
	ios_base::sync_with_stdio(false);
	cin.tie(NULL); cout.tie(NULL);
	cin >> n >> k; 
	for (int i = 1; i <= n; i++) cin >> a[i]; 
	deque<int> mx,mn; 
	int lo = 1; 
	for (int i = 1; i <= n; i++){
		while (!mn.empty() && a[i] < a[mn.back()]) mn.pop_back(); 
		while (!mx.empty() && a[i] > a[mx.back()]) mx.pop_back(); 
		mn.push_back(i); mx.push_back(i); 
		while (a[mx.front()] - a[mn.front()] > k){
			lo++; 
			if (lo > mx.front()) mx.pop_front(); 
			if (lo > mn.front()) mn.pop_front(); 
		}
		ans += i - lo + 1; 
	}
	cout << ans; 
	return 0;
}
