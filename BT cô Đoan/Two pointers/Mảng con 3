#include <bits/stdc++.h>
using namespace std;
const int nm = 1e6 + 9;
const int N = 1e3 + 9;
const int MOD = 1e9 + 7;
#define el '\n'
int n,k,a[nm],ans; 
map<int,int> mp; 

signed main (){
	ios_base::sync_with_stdio(false);
	cin.tie(NULL); cout.tie(NULL);
	cin >> n >> k; 
	for (int i = 1; i <= n; i++) cin >> a[i]; 
	int i = 1; 
	for (int j = 1; j <= n; j++){
		mp[a[j]]++; 
		while (mp.size() > k && i < j){
			mp[a[i]]--; 
			if (mp[a[i]] == 0) mp.erase(a[i]); 
			i++;
		}
		ans += j - i + 1; 
	}
	cout << ans; 
	return 0;
}
