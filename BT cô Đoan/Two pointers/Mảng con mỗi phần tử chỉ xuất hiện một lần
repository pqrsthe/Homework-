#include <bits/stdc++.h>
using namespace std;
const int nm = 1e6 + 9;
const int N = 1e3 + 9;
#define el '\n'
int a[nm],ans;
map<int,int> mp;
void solve(){
    int n; cin >> n;
    for (int i = 1; i <= n; i++) cin >> a[i]; 
    int i = 1, j = 1; 
    a[n + 1] = a[n];
    while (i <= n+1 && j <= n+1){
    	mp[a[j]]++; 
    	while (mp.size() < (j - i + 1)){
    		ans = max(ans , j - i);
    		mp[a[i]]--; 
    		if (mp[a[i]] == 0) mp.erase(a[i]);
			i++; 
		}
		j++;
	}
	cout << ans;
}

signed main (){
	ios_base::sync_with_stdio(false);
	cin.tie(NULL); cout.tie(NULL);
	int t = 1; 
	while (t--){
	    solve();
	}
	return 0;
}
