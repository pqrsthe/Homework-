#include <bits/stdc++.h>
using namespace std;
const int nm = 1e6 + 9;
const int N = 1e3 + 9;	
#define el '\n'
#define int long long
int a[nm]; 
map<int,int> mp; 
void solve(){
    int n,k; cin >> n >> k; 
    for (int i= 1; i <= n; i++){
    	cin >> a[i]; 
	}
	int i = 1, j = 1, dem = 0; 
	while (i <= n && j <= n){
		while (j <= n && mp.size() <= k){
			mp[a[j]]++; j++; 
		} 
//		dem += (j - 1) - i + 1; 
		while (mp.size() > k && i < j){
//			cout << i << " " << j << el;
			dem += j - i - 1;
			mp[a[i]]--;
			if (mp[a[i]] == 0) mp.erase(a[i]); 
			i++; 
		} 
	}
	cout << dem + (n-i+1)*(n-i+2)/2; 
//	cout << i << " " << j << " " << dem << el;
}

signed main (){
	ios_base::sync_with_stdio(false);
	cin.tie(NULL); cout.tie(NULL);
	int t = 1; 
	while (t--){
	    solve();
	}
	return 0;
}
