#include <bits/stdc++.h>
using namespace std;
const int nm = 1e6 + 9;
const int N = 1e3 + 9;
#define el '\n'
int n,s,a[nm];
signed main (){
	ios_base::sync_with_stdio(false);
	cin.tie(NULL); cout.tie(NULL);
	cin >> n >> s; 
	for (int i = 1; i<= n; i++) cin >> a[i]; 
	sort (a + 1, a + 1 + n); 
	int i = 1, j = n; 
	while (i != j && i <= n && j >= 1){
		if (a[i] + a[j] == s){
			cout << "YES"; return 0; 
		}
		else if (a[i] + a[j] > s) j--; 
		else i++; 
	}
	cout << "NO";
	return 0;
}
