#include <bits/stdc++.h>
using namespace std;
const int nm = 1e6 + 9;
const int N = 1e3 + 9;
const int MOD = 1e9 + 7;
#define el '\n'
long long n; 
int Max(long long n){
	if (n < 10) return n; 
	int dv = n % 10; 
	return max(Max(n/10),dv); 	
}

int Min(long long n){
	if (n < 10) return n; 
	int dv = n % 10; 
	return min(Min(n/10),dv); 
}

signed main (){
	ios_base::sync_with_stdio(false);
	cin.tie(NULL); cout.tie(NULL);
	cin >> n; 
	cout << Max(n) << " " << Min(n); 
	return 0;
}
