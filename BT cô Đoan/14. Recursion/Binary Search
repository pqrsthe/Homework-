#include <bits/stdc++.h>
using namespace std;
const int nm = 1e6 + 9;
const int N = 1e3 + 9;
const int MOD = 1e9 + 7;
#define el '\n'
int n,x,a[nm]; 
bool cnp(int l, int r){
	if (l > r) return false; 
	int mid = l + r >> 1; 
	if (a[mid] == x){
		return true; 
	}
	if (a[mid] > x) return cnp(mid+1,r); 
	else return cnp(l,mid-1); 
}

signed main (){
	ios_base::sync_with_stdio(false);
	cin.tie(NULL); cout.tie(NULL);
	cin >> n >> x; 
	for (int i = 1; i <= n; i++) cin >> a[i]; 
	if (cnp(1,n)) cout << "YES"; else cout << "NO";
	return 0;
}
