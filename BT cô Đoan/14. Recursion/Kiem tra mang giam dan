using namespace std;
const int nm = 1e6 + 9;
const int N = 1e3 + 9;
const int MOD = 1e9 + 7;
#define el '\n'
int n,a[nm]; 
bool ok(int n){
	if (n == 0) return true; 
	if (a[n] > a[n + 1]) return ok(n-1); 
	else return false; 
}
signed main (){
	ios_base::sync_with_stdio(false);
	cin.tie(NULL); cout.tie(NULL);
	cin >> n; 
	for (int i = 1; i <= n; i++) cin >> a[i]; a[n+1] = -1; 
	if (ok(n)) cout << "YES"; else cout << "NO"; 
	return 0;
}
