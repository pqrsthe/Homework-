		else if (i == 2) dau[i] = '*';
	}
	while (cin >> a[0] >> a[1] >> a[2] >> a[3] >> a[4]){
		fill(used, used + 10, false);
		int d = 0, cnt = 4; 
		for (int i = 0; i < 5; i++) if (a[i] == 0) d++; 
		if (d == 5) return 0;
		bt_(0); 
		if (sta) cout << "Possible" << el; 
		else cout << "Impossible" << el; 
		sta = false;
	}
	return 0;
}
