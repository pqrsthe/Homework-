#include <bits/stdc++.h>
using namespace std;
const int nm = 1e6 + 9;
const int N = 1e3 + 9;
#define el '\n'
int n,x[N],k;
bool used[N];

void Print(){
	for (int i = 1; i <= k; i++) cout << x[i] << " ";
	cout << el; 
}

void bt(int i){
	for (int j = 1; j <= n; j++){
		if (j > x[i - 1] && used[j] == false){
			used[j] = true; 
			x[i] = j; 
			if (i == k) Print();
			else bt(i+1);
			used[j] = false;
		} 
	}
}

int main (){
	ios_base::sync_with_stdio(false);
	cin.tie(NULL); cout.tie(NULL);
	cin >> n>>k; bt(1);
	return 0;
}
